#!/bin/sh
# Enforce Conventional Commits: <type>(<scope>)!: <subject>
# Wired up by `npm install` via the package.json `prepare` script (core.hooksPath).
set -e

msg_file="$1"
[ -n "$msg_file" ] || exit 0

# First non-blank, non-comment line is the header. Git's autosquash prefixes are stripped.
header=$(sed -e '/^#/d' -e '/^[[:space:]]*$/d' "$msg_file" | head -n 1 | sed -E 's/^(fixup|squash|amend)! //')
[ -n "$header" ] || exit 0

# Merge/revert commits are generated by git itself.
case "$header" in
  'Merge '*|'Revert '*|'Initial commit') exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
subject=$(printf '%s' "$header" | sed -E 's/^[a-z]+(\([^)]*\))?!?: //')

fail() {
  printf '\n✖ %s\n' "$1"
  shift
  for line in "$@"; do printf '  %s\n' "$line"; done
  printf '\n'
  exit 1
}

# 1. Shape: <type>(<scope>)!: <subject>
if ! printf '%s' "$header" | grep -qE "^($types)(\([a-z0-9._/-]+\))?!?: .+$"; then
  fail "Commit header does not follow Conventional Commits." \
    "got:    $header" \
    "expect: <type>(<scope>): <subject>" \
    "type:   $(printf '%s' "$types" | sed 's/|/ /g')" \
    "e.g.    feat(voice): speak replies through the translation director" \
    "        fix: keep the window alive when the Pi worker restarts" \
    "        refactor(ipc)!: drop the legacy session channel"
fi

# 2. English comes first: imperative, lowercase, ASCII.
printf '%s' "$subject" | grep -qE '^[a-z0-9]' ||
  fail "Subject must start lowercase and in English." "got:    $subject" "e.g.    fix: drop the stale session channel"

# 3. No trailing period — the header is a title, not a sentence.
case "$header" in
  *.) fail "Commit header ends with a period." "got:    $header" "drop the trailing '.' — the header is a title, not a sentence." ;;
esac

# 4. Width, so `git log --oneline` stays readable.
width=$(printf '%s' "$header" | wc -m | tr -d ' ')
[ "$width" -le 100 ] || fail "Commit header is $width chars, limit is 100." "got:    $header" "move the details into the body."

# 5. A breaking change must say what breaks.
case "$header" in
  *'!:'*)
    grep -qE '^BREAKING[ -]CHANGE: ' "$msg_file" ||
      fail "Breaking change marker '!' without a BREAKING CHANGE: footer." "got:    $subject" "add a footer line: BREAKING CHANGE: <what callers must change>"
    ;;
esac

exit 0
